{
  "product": {
    "name": "Streamable",
    "site": "https://streamable.run",
    "repoUrl": "https://github.com/teliclabs/streamable",
    "branch": "main",
    "localRepoDir": "repo/streamable"
  },
  "report": {
    "lookbackDays": 7,
    "timezone": "America/Los_Angeles",
    "audience": "streamers and technically involved stream operators such as mods, editors, producers, and RTMP/SRT/OBS setup people",
    "publishingTest": "Would this be appropriate and good for a Streamable user to see?",
    "minBullets": 4,
    "targetBullets": 6,
    "recipient": "nathanang2000@gmail.com",
    "from": "Nang <nang@streamable.run>",
    "replyTo": "nang@streamable.run",
    "subjectPrefix": "Streamable weekly Discord update draft"
  },
  "publicUpdates": {
    "url": "https://streamable.run/updates",
    "productRepoDir": "repo/streamable",
    "dataFile": "webapp/content/product-updates.ts",
    "routeFile": "webapp/app/(main)/updates/page.tsx",
    "stylesFile": "webapp/app/(main)/updates/updates.module.css",
    "buildWorkingDir": "repo/streamable/webapp",
    "buildCommand": "npm run build",
    "commitMessagePrefix": "Update public updates log"
  },
